mapa_interativo_alternativo <- function(
df,
var,
titulo = "",
quart = FALSE,
coluna_regiao = "regiao_intermediaria",
mapa = mapa_MG
) {
# Renomeia a coluna da região para "regiao" dentro do df
df2 <- df |>
rename(regiao = all_of(coluna_regiao))
# Renomeia no mapa também para facilitar união
mapa2 <- mapa |>
rename(regiao = all_of(coluna_regiao))
# Faz o join
mapa_join <- mapa2 |>
left_join(df2, by = "regiao")
# Variável a ser plotada
x <- mapa_join[[var]]
# Paleta de cores
if (quart) {
brks <- quantile(x, probs = seq(0,1,0.25), na.rm = TRUE)
pal <- colorBin("RdYlBu", domain = x, bins = brks, reverse = TRUE)
} else {
pal <- colorNumeric("RdYlBu", domain = x, reverse = TRUE)
}
# Mapa
leaflet(mapa_join) |>
addTiles() |>
addPolygons(
fillColor = ~pal(.data[[var]]),
weight = 0.3,
opacity = 1,
color = "black",
fillOpacity = 0.8,
label = ~paste0(
"<b>", regiao, "</b><br>",
var, ": ", round(.data[[var]], 3)
) |> lapply(htmltools::HTML)
) |>
addLegend(
pal = pal,
values = x,
title = titulo
)
}
